      <h>100</h>
    </coordinates>
    <panel_attributes>&lt;&lt;Constraint&gt;&gt;
ValidEmployeeCode
--
+ NotBlank
+ code must match pattern "^[A-Z]{4}-[0-9]{2}$"
+ The last two digits correspond to the current year
bg=RED</panel_attributes>
    <additional_attributes/>
