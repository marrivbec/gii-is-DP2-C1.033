      <y>270</y>
      <w>370</w>
      <h>110</h>
    </coordinates>
    <panel_attributes>&lt;&lt;Constraint&gt;&gt;
ValidPhone
--
+ countryCode must be in range 1..999
+ areaCode must be in range 1..99999
+ number must match pattern "\d{1,9}([\s-]\d{1,9}){0,5}"
bg=RED</panel_attributes>
    <additional_attributes/>
  </element>
